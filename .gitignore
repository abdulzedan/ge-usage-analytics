# Collected telemetry. Contains real user identities and prompt text,
# never commit these.
*.db
*.db-journal
*.db-wal
*.db-shm
collect.log

# Rendered dashboards embed the same data.
dashboard.html
/*.html

# Documentation screenshots are generated from synthetic data and ARE tracked;
# everything else image-shaped is not.
*.png
!docs/images/*.png

# Python
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
